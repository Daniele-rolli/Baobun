# ---------------------------------------------------------------------------
# Baobun configuration
# Copy to .env and adjust. `docker compose` reads this file for variable
# interpolation and build args.
# ---------------------------------------------------------------------------

# --- Postgres ---
POSTGRES_USER=baobun
POSTGRES_PASSWORD=change_me
POSTGRES_DB=baobun
POSTGRES_PORT=5432

# --- MinIO ---
MINIO_ROOT_USER=baobun
MINIO_ROOT_PASSWORD=change_me
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101

# --- Public URL ---
# Optional canonical URL for reset links and calendar subscriptions.
# Leave blank to derive it from the request forwarded by the frontend.
PUBLIC_URL=
API_PORT=3001
FRONTEND_PORT=4173

# --- Mail (SMTP) ---
# MAIL_DEBUG=true prints previews instead of sending (dev only).
# For production set MAIL_DEBUG=false and configure a real SMTP relay.
MAIL_DEBUG=true
MAIL_SENDER=Baobun <no-reply@baobun.local>
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=

# --- Mailpit (dev inbox) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
