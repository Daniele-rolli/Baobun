# ---------------------------------------------------------------------------
# Baobun configuration. Copy to .env and set these two required values.
# ---------------------------------------------------------------------------

POSTGRES_PASSWORD=change_me
PUBLIC_URL=https://baobun.example.com

# Optional host port.
FRONTEND_PORT=4173

# Optional SMTP. With MAIL_DEBUG=true, messages are logged instead of sent.
MAIL_DEBUG=true
MAIL_SENDER=Baobun <no-reply@baobun.local>
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
