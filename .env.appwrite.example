APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DB_ID=
APPWRITE_USERS_COLLECTION=
APPWRITE_GROUPS_COLLECTION=
APPWRITE_MEMBERS_COLLECTION=
APPWRITE_EVENTS_COLLECTION=
APPWRITE_TAGS_COLLECTION=
APPWRITE_AVATAR_BUCKET=
APPWRITE_TAG_ICONS_BUCKET=
APPWRITE_CALENDAR_FEEDS_BUCKET=
